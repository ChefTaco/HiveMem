{
  "name": "@hivemagnus/hivemem-server",
  "version": "1.10.0",
  "description": "HiveMem: a self-hosted shared memory server for AI agents, with a REST API, JWT auth, and Qdrant persistence.",
  "keywords": [
    "hive",
    "hivemem",
    "memory",
    "agent-memory",
    "ai-agents",
    "llm",
    "qdrant",
    "rest-api",
    "server"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/ChefTaco/HiveMem#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/HiveMem/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/HiveMem.git"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "hivemem-server": "dist/src/cli.js",
    "hivemem-ts-core": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node -e \"require('node:fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "test": "npm run build && HIVEMEM_PERSISTENCE_VERIFY=1 node --test dist/tests/*.test.js",
    "start": "node dist/src/cli.js",
    "dev": "node --experimental-strip-types src/cli.ts",
    "test:dual-stack": "npm run build && node --test dist/tests/dual-stack-compat.test.js",
    "prepublishOnly": "npm run clean && npm test",
    "prebuild": "node ../scripts/build-release-runtime.mjs",
    "pretypecheck": "node ../scripts/build-release-runtime.mjs",
    "pretest": "node ../scripts/build-release-runtime.mjs",
    "postbuild": "node ../scripts/build-release-runtime.mjs --copy"
  },
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@hivemagnus/hive-common": "^0.5.1",
    "@photostructure/sqlite": "3.3.1",
    "jose": "6.2.17",
    "zod": "4.6.7"
  }
}
