# HiveMem settings. `hivemem-server env-schema` lists what the server reads, and
# ts-core/README.md#configuration documents every variable. Keep the real file private (mode 0600)
# and pass it with `--env-file`; the server does not read ./.env on its own.

# Required. Generate with: openssl rand -hex 32
HIVEMEM_JWT_SECRET=
# Optional independent key for scoped renewal grants. Never copy this key to clients.
HIVEMEM_RENEWAL_SECRET=

# Listener: 127.0.0.1:18790 by default. Use 0.0.0.0 only with TLS or behind a trusted proxy.
# The systemd unit sets HIVEMEM_TS_CORE_HOST=0.0.0.0; scripts/deploy_server.sh writes
# HIVEMEM_WEB_PORT (18443 unless set) into the target's env file.
# HIVEMEM_TS_CORE_HOST=127.0.0.1
# HIVEMEM_WEB_PORT=18790
# Set both to serve HTTPS; set neither for plain HTTP.
# HIVEMEM_TLS_CERT_FILE=/etc/hivemem/tls/server.crt
# HIVEMEM_TLS_KEY_FILE=/etc/hivemem/tls/server.key

# Qdrant holds the memories. Keep it on localhost or a private network.
# HIVEMEM_QDRANT_URL=http://127.0.0.1:6333
# Local state: writer lock, write-recovery journal and token revocation list.
HIVEMEM_STORAGE_PATH=/var/opt/hivemem
# HIVEMEM_REVOCATION_FILE=/var/opt/hivemem/revoked-tokens.json

# /metrics requires an admin JWT or this scrape token (>= 32 chars).
# HIVEMEM_METRICS_TOKEN=
# Allow unauthenticated scraping from loopback clients only.
# HIVEMEM_METRICS_ALLOW_LOOPBACK=false

# Optional semantic shadow index over an OpenAI-compatible /v1/embeddings endpoint. Set all or none.
# HIVEMEM_EMBEDDING_ENDPOINT=https://embeddings.example.com/v1/embeddings
# HIVEMEM_EMBEDDING_MODEL=
# HIVEMEM_EMBEDDING_REVISION=
# HIVEMEM_EMBEDDING_DIMENSIONS=
# HIVEMEM_SEMANTIC_COLLECTION=hivemem_shadow_example

# Operator-owned releases default to explicit migrations and no background updates.
# Suite installs write their own settings; see "Managed upgrades" in ts-core/README.md.
HIVE_AUTO_MIGRATE=false
HIVE_UPDATE_CHECK=false
HIVE_AUTO_UPGRADE=false
HIVE_UI_UPGRADE=false
HIVE_COMPOSE_UPGRADE_SUPERVISOR=false

# --- Read by the SDKs, helper scripts and scripts/deploy_server.sh, not by the server ---

# Canonical external URL for clients and scripts. Override per deployment.
HIVEMEM_API_URL=https://hivemem.example.com
# Optional client-side trust anchor for private PKI. TLS verification remains mandatory.
# HIVEMEM_CA_FILE=/etc/hivemem/client-ca.pem
# Admin JWT for the helper scripts (register_agent.py, backup.py, prune.py).
HIVEMEM_ADMIN_TOKEN=
HIVEMEM_BACKUP_PATH=/var/opt/hivemem/backups
HIVEMEM_BACKUP_RETENTION_DAYS=30

# scripts/deploy_server.sh: target host and credentials. Prefer key auth (HIVEMEM_SSH_KEY).
SSH_HOST=
SSH_USERNAME=
SSH_PASSWORD=
# TypeScript is the only deployable runtime.
HIVEMEM_RUNTIME=typescript
# Operator-only controls normally belong in the invoking shell, not this file:
# HIVEMEM_PRESERVE_REMOTE_ENV=true keeps the target's private env authoritative.
# HIVEMEM_REFRESH_ADMIN_TOKEN=true opts into refreshing its existing admin bearer.
# Preserved environments retain the bearer by default.
